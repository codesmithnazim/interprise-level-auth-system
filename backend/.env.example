NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shop

# Exact frontend origin(s), comma separated. No trailing slash. No "*".
CLIENT_ORIGINS=http://localhost:5173

# Generate EACH one separately with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-48-random-bytes-base64url-xxxxxxxxxxxx
OTP_PEPPER=replace-with-another-48-random-bytes-base64url-xxxxxxxx

# Number of reverse proxies in front of Node (nginx/ALB = 1). 0 = none.
TRUST_PROXY=0

# SMTP (required in production). In dev, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Shop <no-reply@shop.example.com>"
